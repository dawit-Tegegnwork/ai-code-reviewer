{
  "name": "ai-code-reviewer",
  "version": "1.0.0",
  "description": "🤖 Enterprise-grade AI-powered code review system with LLM integration and security scanning",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "docker:build": "docker build -t ai-code-reviewer .",
    "docker:run": "docker-compose up -d"
  },
  "keywords": [
    "ai",
    "code-review",
    "security",
    "static-analysis",
    "gpt-4",
    "llm",
    "ci-cd",
    "enterprise"
  ],
  "author": "Dawit Tegegnwork",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@langchain/openai": "^0.1.1",
    "ai": "^3.0.0",
    "bullmq": "^5.1.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "langchain": "^0.1.0",
    "openai": "^4.28.0",
    "prisma": "^5.9.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "semgrep": "^1.0.0",
    "snyk": "^1.1250.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "playwright": "^1.41.0",
    "prettier": "^3.2.0",
    "prisma": "^5.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
